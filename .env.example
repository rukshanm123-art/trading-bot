# ============================================================
# trading-bot environment template
# Copy to .env and fill in. NEVER commit a real .env.
# The bot loads these from the process environment; .env is a
# convenience for docker compose / direnv, not a config file.
# ============================================================

# ---- Mode is set in the YAML config, NOT here. ----

# ---- Testnet credentials (Binance Spot Testnet: https://testnet.binance.vision) ----
# Only used when mode=testnet. Distinct variable names from live keys on purpose:
# a testnet key can never be read into a live session or vice versa.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# ---- Live credentials (LEAVE EMPTY until the live checklist passes) ----
# Create a DEDICATED API key with:
#   - Spot trading: ENABLED
#   - Withdrawals:  DISABLED  (the bot refuses to run if withdrawals are enabled)
#   - IP allowlist: your server IP only
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# ---- Live-mode double lock ----
# Even after `trading-bot live unlock`, live mode refuses to start
# unless this is explicitly "true".
LIVE_TRADING_ENABLED=false

# ---- Kill switch (any value of "true" halts new entries immediately) ----
TRADING_KILL_SWITCH=false

# ---- Notifications (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# ---- Database (optional for evaluation; REQUIRED for qualification) ----
# SQLite is non-qualifying. Before qualification day one, select the long-lived
# Postgres deployment: postgresql://bot:***@db:5432/trading_bot
DATABASE_URL=

# ---- Monitoring endpoint auth token (optional; endpoint binds 127.0.0.1) ----
MONITORING_TOKEN=
